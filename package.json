{
  "name": "microchat",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Chat local en español con Gemini Nano y documentos de texto.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
